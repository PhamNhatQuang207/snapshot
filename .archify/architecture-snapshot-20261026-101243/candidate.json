  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and auth",
      "items": [
        "One free HTTPS URL: CloudFront serves the SPA and photos from S3, forwards /api/* to the ALB",
        "ALB accepts traffic only from CloudFront's IP prefix list",
        "Every Go service validates the Cognito JWT itself"
      ]
    },
    {
      "dot": "violet",
      "title": "Event-driven core",
      "items": [
        "post-service and user-service publish events to one SNS topic",
        "SNS fans out to one SQS queue per consumer, each with a DLQ",
        "feed-service fans out on write into Redis; reads hydrate post details from post-service"
      ]
    },
    {
      "dot": "emerald",
      "title": "Platform (not drawn)",
      "items": [
        "EKS managed node group on spot instances, images in ECR",
        "Argo CD syncs Helm charts from Git; GitHub Actions builds and pushes",
        "Per-service IAM via Pod Identity; secrets from Secrets Manager via External Secrets"
      ]
    },
    {
      "dot": "amber",
      "title": "Observability and cost",
      "items": [
        "Prometheus + Grafana, Loki logs, OpenTelemetry traces to Tempo; CloudWatch for managed services",
        "All of it is Terraform; make down destroys everything except state bucket and ECR"
      ]
    }
  ]
}